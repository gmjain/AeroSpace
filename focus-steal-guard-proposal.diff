+
+/// [FORK gmjain/AeroSpace] PROPOSAL (review finding 4, 2026-09-05) — not applied.
+/// A guarded app's focus on a hidden workspace is taken as the user's own doing when
+///   (1) the session is NSWorkspaceDidActivateApplication (app switch, not a bare AXFocusedWindowChanged),
+///   (2) it is a cross-app switch: the previously native-focused window belonged to another pid, and
+///   (3) no hotkey binding ran within the last 2s.
+/// fork-debug.log evidence: every WezTerm steal that carried an intent tag arrived 67-1207ms after a
+/// hotkey (alt-enter spawn), and 28 WezTerm rejections arrived in didActivateApplication sessions ~1ms
+/// before their AXFocusedWindowChanged twin — so "reject only .ax sessions" would accept the steal in
+/// the first session; (3) is what keeps them rejected. cmd-tab, Dock clicks and link clicks from other
+/// apps are not AeroSpace hotkeys and pass. Coincidence windows: a genuine cmd-tab within 2s of a
+/// hotkey still snaps back (today's behavior); a background re-key >2s after a *mouse-driven* window
+/// close would be accepted (the hotkey-driven close/switch sequence stays covered).
+@MainActor private func isDeliberateCrossAppActivation(_ nativeFocused: Window) -> Bool {
+    guard case .globalObserver(let notif)? = refreshSessionEvent,
+          notif == NSWorkspace.didActivateApplicationNotification.rawValue else { return false }
+    let prevPid = lastKnownNativeFocusedWindowId.flatMap { Window.get(byId: $0) }?.app.pid
+    guard prevPid != nativeFocused.app.pid else { return false }
+    return Date().timeIntervalSince(lastHotkeyBindingAt) > 2
 }
